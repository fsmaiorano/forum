{
  "UseInMemoryDatabase": true,
  "ConnectionStrings": {
    "DefaultConnection": "connection string for development environment"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Forum"
    }
  }
}
