{
  "UseInMemoryDatabase": false,
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "connection string for production environment"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Notification"
    }
  }
}
