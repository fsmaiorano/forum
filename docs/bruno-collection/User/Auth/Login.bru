meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{user_base_url}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "user@example.com",
    "password": "Password123!"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("access_token", res.body.accessToken);
    bru.setVar("refresh_token", res.body.refreshToken);
  }
}

docs {
  Login with existing user credentials.
  
  On success, the access and refresh tokens are automatically saved to environment variables.
}

