meta {
  name: Create Answer
  type: http
  seq: 1
}

post {
  url: {{forum_base_url}}/answer
  body: json
  auth: none
}

body:json {
  {
    "questionId": "019ba3a0-649e-72b2-b927-864e69e96688",
    "authorId": "{{user_id}}",
    "content": "Here is my answer to your question. You can implement authentication using ASP.NET Core Identity...",
    "attachments": [
      {
        "ownerId": "{{user_id}}",
        "ownerType": 2,
        "title": "Code Example",
        "link": "https://example.com/code-example.cs"
      }
    ]
  }
}

docs {
  Create a new answer for a question.
  
  AttachmentOwnerType:
  - 1: Question
  - 2: Answer
}
